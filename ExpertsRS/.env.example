# ExpertsRS local LLM configuration template.
# Copy/fill this file as ExpertsRS/.env. NEVER commit the filled .env.
# The runtime reads only the variable names selected below; it never puts key
# values into RunRequest, manifest, trace, or model-visible state.

# ---- Optional legacy profiles ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3

# ---- Provider profile 1: SiliconFlow ----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=

# ---- Provider profile 2: Paratera (OpenAI-compatible) ----
PARATERA_API_KEY=
PARATERA_BASE_URL=https://llmapi.paratera.com/v1
PARATERA_MODEL=

# Optional generic OpenAI-compatible profile for another provider.
THIRD_PARTY_API_KEY=
THIRD_PARTY_BASE_URL=
THIRD_PARTY_MODEL=

# ---- Active D3 smoke selection ----
# Set these three lines to select one profile. Example for SiliconFlow:
#   EXPERTSRS_D3_LIGHT_MODEL=the-exact-model-id-from-the-provider-console
#   EXPERTSRS_D3_LIGHT_API_KEY_ENV=SILICONFLOW_API_KEY
#   EXPERTSRS_D3_LIGHT_BASE_URL_ENV=SILICONFLOW_BASE_URL
EXPERTSRS_D3_LIGHT_MODEL=
EXPERTSRS_D3_LIGHT_API_KEY_ENV=
EXPERTSRS_D3_LIGHT_BASE_URL_ENV=
EXPERTSRS_D3_LIGHT_MAX_COMPLETION_TOKENS=1024

# Keep closed until the provider/model, disclosure boundary, and protocol
# version are reviewed. The second gate is the frozen panel commit.
EXPERTSRS_D3_LIGHT_ALLOW_API=NO
