    "fontSize": "18px",
    "primaryColor": "#DCEAF7",
    "primaryTextColor": "#1F2937",
    "primaryBorderColor": "#4B5563",
    "lineColor": "#4B5563",
    "secondaryColor": "#DDEFEA",
    "tertiaryColor": "#FCE8D5",
    "clusterBkg": "#F8FAFC",
    "clusterBorder": "#64748B",
    "edgeLabelBackground": "#FFFFFF",
    "mainBkg": "#FFFFFF",
